{
  "name": "@elumixor/nitro-client",
  "version": "3.3.2",
  "description": "Generate a typed API client from Nitro route handlers",
  "repository": {
    "type": "git",
    "url": "https://github.com/elumixor/nitro-client.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/generate.d.mts",
      "default": "./dist/generate.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "default": "./dist/server/index.mjs"
    }
  },
  "bin": {
    "nitro-client": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "lint": "tsc --noEmit && biome check src",
    "test": "npm run build && npm run lint",
    "format": "biome format --write src",
    "release:patch": "npm version patch -m \"Release v%s\" && git push --tags",
    "release:minor": "npm version minor -m \"Release v%s\" && git push --tags",
    "release:major": "npm version major -m \"Release v%s\" && git push --tags"
  },
  "dependencies": {
    "@elumixor/zod-config-cli": "^1.0.3",
    "ts-morph": "^25.0.1"
  },
  "peerDependencies": {
    "h3": ">=1.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/bun": "latest",
    "@types/node": "^25.5.2",
    "h3": "^1.15.1",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "zod": "^4.3.6"
  }
}
