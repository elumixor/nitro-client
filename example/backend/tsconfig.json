{
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@elumixor/nitro-client/server": ["../../dist/server/index.d.mts"]
    }
  }
}
